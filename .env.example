# Copy to .env and fill in. Never commit .env.

# --- Spec (BUILD_PROMPT.md section 14) ---
DATABASE_URL=postgres://hatchery:hatchery-dev-only@127.0.0.1:5433/hatchery
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_MAX_TURNS=20
WORKER_COUNT=2
GLOBAL_DAILY_CAP_USD=100
RUNWAY_TARGET_DAYS=30
KILL_SWITCH=0
JUDGE_TIMEOUT_SECONDS=300
JUDGE_MEMORY_MB=8192
TREASURY_CHAIN=mock
TREASURY_ADDRESS=
PRICE_SOURCE=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_HANDLES=
PUBLIC_SITE_URL=

# --- Judge (Phase 0 additions) ---
# full = pinned Mathlib (default), lite = Lean core only (dev/tests)
JUDGE_FLAVOR=full
JUDGE_IMAGE=hatchery-lean-runner:full
JUDGE_CPUS=2
JUDGE_CONCURRENCY=1
# If set, POST /check requires "Authorization: Bearer <token>"
JUDGE_API_TOKEN=

# --- Local postgres (docker compose) ---
POSTGRES_PASSWORD=hatchery-dev-only
POSTGRES_PORT=5433

# --- Desk / worker (Phase 1 additions) ---
# Shared secret between desk and workers (>= 16 chars). Generate: openssl rand -hex 24
DESK_WORKER_TOKEN=
DESK_URL=http://127.0.0.1:4200
JUDGE_URL=http://127.0.0.1:4100
AGENT_ID=agent-1
# low | medium | high | xhigh | max
AGENT_EFFORT=high
AGENT_MAX_TOKENS=16000
# Server-side refusal fallback on model calls (1 = on)
AGENT_REFUSAL_FALLBACK=1
AGENT_MAX_ATTEMPTS_PER_LEMMA=3
LEMMA_ABANDON_AFTER_ATTEMPTS=12
LEASE_TTL_SECONDS=1800
# Optional extra stop for one worker process, in USD of its recorded spend (0 = off; the desk's caps always apply)
WORKER_MAX_RUN_USD=0
WORKER_MAX_LEMMAS=0
WORKER_EXIT_WHEN_IDLE=0
# Keep 0 until the `full` job of .github/workflows/judge.yml is green (docs/deploy.md)
MATHLIB_LEMMAS_ENABLED=0
# Commit recorded with a checked proof when PROOF_COMMIT_MODE is not "commit" (otherwise the bot commit is used)
GIT_COMMIT=
# Optional JSON override/extension of packages/shared/src/prices.ts
PRICE_TABLE_JSON=
RECHECK_INTERVAL_SECONDS=300

# --- Phase 2: budget, kill switch, collaboration, proof commits ---
# Bearer token for /admin/* (kill switch). Admin routes are off when empty. (Phase 6: GitHub OAuth allowlist)
ADMIN_TOKEN=
ACTIVE_AGENT_WINDOW_SECONDS=900
ASK_AFTER_CONSECUTIVE_FAILURES=3
MAX_QUESTIONS_PER_HOUR=2
MAX_REPLIES_PER_HOUR=6
QUESTION_TTL_SECONDS=1800
HANDOFF_OFFER_SECONDS=600
AGENT_REPLY_MAX_TOKENS=1024
AGENT_ID_PREFIX=agent
WORKER_IDLE_SLEEP_SECONDS=30
WORKER_SLEEP_POLL_SECONDS=60
WORKER_REPLY_WAIT_SECONDS=120
# commit = write lean/Proofs/<L>.lean and git-commit only that file; write = file only; off = DB only
PROOF_COMMIT_MODE=commit
PROOF_COMMIT_AUTHOR_NAME=Hatchery Judge
PROOF_COMMIT_AUTHOR_EMAIL=judge@hatchery.invalid
# docker compose: the desk runs as the checkout owner so it can commit (Linux: id -u / id -g)
HATCHERY_UID=1000
HATCHERY_GID=1000
