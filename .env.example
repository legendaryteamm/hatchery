# Copy to .env and fill in. Never commit .env.

# --- Spec (BUILD_PROMPT.md section 14) ---
DATABASE_URL=postgres://hatchery:hatchery-dev-only@127.0.0.1:5433/hatchery
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_MAX_TURNS=20
WORKER_COUNT=2
GLOBAL_DAILY_CAP_USD=100
RUNWAY_TARGET_DAYS=30
KILL_SWITCH=0
JUDGE_TIMEOUT_SECONDS=300
JUDGE_MEMORY_MB=8192

# --- Judge (Phase 0 additions) ---
# full = pinned Mathlib (default), lite = Lean core only (dev/tests)
JUDGE_FLAVOR=full
JUDGE_IMAGE=hatchery-lean-runner:full
JUDGE_CPUS=2
JUDGE_CONCURRENCY=1
# If set, POST /check requires "Authorization: Bearer <token>"
JUDGE_API_TOKEN=

# --- Local postgres (docker compose) ---
POSTGRES_PASSWORD=hatchery-dev-only
POSTGRES_PORT=5433

# --- Desk / worker (Phase 1 additions) ---
# Shared secret between desk and workers (>= 16 chars). Generate: openssl rand -hex 24
DESK_WORKER_TOKEN=
DESK_URL=http://127.0.0.1:4200
JUDGE_URL=http://127.0.0.1:4100
AGENT_ID=agent-1
# low | medium | high | xhigh | max
AGENT_EFFORT=high
AGENT_MAX_TOKENS=16000
# Server-side refusal fallback on model calls (1 = on)
AGENT_REFUSAL_FALLBACK=1
AGENT_MAX_ATTEMPTS_PER_LEMMA=3
LEMMA_ABANDON_AFTER_ATTEMPTS=12
LEASE_TTL_SECONDS=1800
# Optional extra stop for one worker process, in USD of its recorded spend (0 = off; the desk's caps always apply)
WORKER_MAX_RUN_USD=0
WORKER_MAX_LEMMAS=0
WORKER_EXIT_WHEN_IDLE=0
# Keep 0 until the `full` job of .github/workflows/judge.yml is green (docs/deploy.md)
MATHLIB_LEMMAS_ENABLED=0
# Commit recorded with a checked proof when PROOF_COMMIT_MODE is not "commit" (otherwise the bot commit is used)
GIT_COMMIT=
# Optional JSON override/extension of packages/shared/src/prices.ts
PRICE_TABLE_JSON=
RECHECK_INTERVAL_SECONDS=300

# --- Phase 2: budget, kill switch, collaboration, proof commits ---
# Bearer token for /admin/* (kill switch). Admin routes are off when empty. (Phase 6: GitHub OAuth allowlist)
ADMIN_TOKEN=
ACTIVE_AGENT_WINDOW_SECONDS=900
ASK_AFTER_CONSECUTIVE_FAILURES=3
MAX_QUESTIONS_PER_HOUR=2
MAX_REPLIES_PER_HOUR=6
QUESTION_TTL_SECONDS=1800
HANDOFF_OFFER_SECONDS=600
AGENT_REPLY_MAX_TOKENS=1024
AGENT_ID_PREFIX=agent
WORKER_IDLE_SLEEP_SECONDS=30
WORKER_SLEEP_POLL_SECONDS=60
WORKER_REPLY_WAIT_SECONDS=120
# sandbox (default) = commit into a throwaway clone; never the real checkout.
# commit / write touch the real checkout and need HATCHERY_REAL_RUN=1 (+ REPO_MOUNT_MODE=rw in docker).
PROOF_COMMIT_MODE=sandbox
HATCHERY_REAL_RUN=0
REPO_MOUNT_MODE=ro
PROOF_SANDBOX_DIR=
# Server only: push bot commits with a repo-scoped deploy key (docs/deploy.md). Never on a laptop.
PROOF_PUSH=0
PROOF_PUSH_REMOTE=origin
PROOF_PUSH_BRANCH=main
PROOF_COMMIT_AUTHOR_NAME=Hatchery Judge
PROOF_COMMIT_AUTHOR_EMAIL=judge@hatchery.invalid
# docker compose: the desk runs as the checkout owner so it can commit (Linux: id -u / id -g)
HATCHERY_UID=1000
HATCHERY_GID=1000

# --- Phase 3: review tool, decomposer ---
# Invite links point here; https:// also marks the review cookie Secure.
PUBLIC_SITE_URL=http://localhost:5173
REVIEW_SESSION_DAYS=30
REVIEW_INVITE_DAYS=7
MAX_PROPOSALS_PER_HOUR=20
DECOMPOSER_ID=decomposer-1
DECOMPOSER_MAX_TURNS=6
DECOMPOSER_INTERVAL_SECONDS=3600
DECOMPOSER_MAX_SESSIONS=0
# Server only, with PROOF_PUSH=1: e.g. ssh -i /run/secrets/proof_bot_deploy_key -o IdentitiesOnly=yes
GIT_SSH_COMMAND=

# --- Public site (Phase 4 additions) ---
# Requests per minute per client on public routes (workers, reviewers and admin are exempt)
RATE_LIMIT_PER_MINUTE=300
# Live event streams open at once per client
MAX_STREAMS_PER_CLIENT=4
# Set to 1 only behind a reverse proxy (Caddy on the VPS) so client addresses come from X-Forwarded-For
TRUST_PROXY=0

# --- Pantry (Phase 5 additions) ---
# Only "mock" has an adapter today (development money, labelled on the site). See HANDOFF.md.
TREASURY_CHAIN=mock
TREASURY_ADDRESS=
# Price source for a real chain's adapter (unused by the mock, which uses MOCK_USD_PER_NATIVE)
PRICE_SOURCE=
# Shared by the desk and the indexer (>= 16 chars): openssl rand -hex 24. Indexer routes are off without it.
INDEXER_TOKEN=
INDEXER_POLL_SECONDS=15
# Mock chain only: a JSON file outside the repo, a fixed USD rate, and optional automatic inflows
MOCK_CHAIN_FILE=
MOCK_USD_PER_NATIVE=1
MOCK_AUTO_INFLOW_SECONDS=0
MOCK_AUTO_INFLOW_NATIVE=25
# Optional: POST pantry alerts here (Slack/Discord-compatible JSON). Alerts are always logged and in the feed.
ALERT_WEBHOOK_URL=
PANTRY_ALERT_CHECK_SECONDS=60

# --- Outside contributors (Phase 6 additions) ---
# GitHub OAuth app (HANDOFF.md). Callback URL: <PUBLIC_SITE_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub logins allowed into /admin, comma-separated
ADMIN_GITHUB_HANDLES=
# Token the contrib-merge workflow uses to report pull requests (>= 16 chars); same value as the
# repository secret DESK_CONTRIB_TOKEN. Contributor CI routes are off without it.
CONTRIB_TOKEN=
# owner/name of the GitHub repository (shown in /join.txt)
CONTRIB_REPO=
# LOCAL ONLY: test login without GitHub. Refused unless PUBLIC_SITE_URL is http://localhost / 127.0.0.1
DEV_LOGIN=0
EXTERNAL_LEASE_MAX_HOURS=6
EXTERNAL_HEARTBEAT_SECONDS=2700
EXTERNAL_HEARTBEAT_GRACE_SECONDS=900
MAX_EXTERNAL_LEASES=20

# --- Production on one VPS (Phase 7; docs/deploy.md) ---
# The public domain (no https://). The prod override sets PUBLIC_SITE_URL=https://$SITE_DOMAIN.
SITE_DOMAIN=
# Receives Let's Encrypt expiry warnings (Caddy gets and renews certificates itself)
ACME_EMAIL=
# Where the proof bot's deploy key and GitHub's known_hosts live on the server
SECRETS_DIR=/srv/hatchery/secrets
# deploy/backup.sh: keep this many days locally; optional rclone remote for off-site copies
KEEP_DAYS=14
BACKUP_REMOTE=

# --- Autonomous review (no human math advisor; docs/autonomous-review.md) ---
# Reviewer agents: one per model (different models where available), e.g. claude-opus-5-5,claude-sonnet-5-5
REVIEWER_MODELS=
REVIEWERS_PER_MODEL=1
# Independent reviewer agents that must ALL agree on a definition (at least 2), and on a statement
DEFINITION_REVIEWERS_REQUIRED=2
STATEMENT_REVIEWERS_REQUIRED=1
# 1 = definition reviewers must use different models (set it when REVIEWER_MODELS has 2+ models)
REVIEW_REQUIRE_DISTINCT_MODELS=0
# The adversary: budget per definition review, and the attempts it must make before giving up
ADVERSARY_BUDGET_USD=2
ADVERSARY_MIN_CHECKS=3
ADVERSARY_MAX_TURNS=12
# Public flags (GitHub issues) per person per day
MAX_FLAGS_PER_LOGIN_PER_DAY=5
# The Phase 3 human review tool, kept in the code but off
HUMAN_REVIEW_TOOL=0
