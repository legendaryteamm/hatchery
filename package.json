{
  "name": "hatchery",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r typecheck",
    "runner:build:lite": "docker build -f apps/judge/runner/Dockerfile --build-arg FLAVOR=lite -t hatchery-lean-runner:lite .",
    "runner:build:full": "docker build -f apps/judge/runner/Dockerfile --build-arg FLAVOR=full -t hatchery-lean-runner:full .",
    "judge:check": "pnpm --filter @hatchery/judge cli check",
    "judge:sample": "pnpm --filter @hatchery/judge sample",
    "desk": "pnpm --filter @hatchery/desk cli",
    "desk:start": "pnpm --filter @hatchery/desk start",
    "worker:start": "pnpm --filter @hatchery/worker start",
    "decomposer:start": "pnpm --filter @hatchery/worker decomposer",
    "web:dev": "pnpm --filter @hatchery/web dev",
    "web:build": "pnpm --filter @hatchery/web build",
    "mock:colony": "pnpm --filter @hatchery/worker mock:colony"
  }
}
